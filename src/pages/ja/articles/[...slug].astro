---
import { getCollection, render } from "astro:content";
import Base from "../../../layouts/Base.astro";
import { CATEGORY_LABELS, imageFor, readingMinutes } from "../../../lib/categories";
export async function getStaticPaths() {
  const articles = await getCollection("articles", ({ data }) => !data.draft);
  return articles.map((article) => ({ params: { slug: article.id }, props: { article } }));
}
const { article } = Astro.props;
const { Content } = await render(article);
const d = article.data;
const cat = d.category || "other";
const img = imageFor(d);
const pageTitle = d.title + " | Doubles Labo";
---
<Base title={pageTitle} description={d.summary || undefined} image={img}>
  <div class="wrap">
    <article class="article">
      <a class="back-link" href="/ja/#latest">← 記事一覧</a>
      <header class="article-header">
        <div class="meta"><span class={"cat c-" + cat}>{CATEGORY_LABELS[cat]}</span>
          <time datetime={d.date.toISOString().slice(0, 10)}>{d.date.toLocaleDateString("ja-JP", { year: "numeric", month: "long", day: "numeric" })}</time>
          <span>· {readingMinutes(article.body)}分で読める</span></div>
        <h1>{d.title}</h1>
      </header>
      <div class="article-cover"><img src={img} alt="" width="1400" height="934" /></div>
      <div class="article-body"><Content /></div>
      <aside class="source-box">
        <div class="t">Source</div>
        {d.sourceUrl ? <a href={d.sourceUrl} target="_blank" rel="noopener noreferrer">{d.source || d.sourceUrl} ↗</a> : (d.source || "—")}
        <div>出典元の内容を要約したものです。原文の権利は出典元に帰属します。</div>
      </aside>
      {d.sample && <p class="sample-note">※公開前のサンプル記事です。自動収集が動き始めたら、実際の要約記事に置き換わります。</p>}
    </article>
  </div>
</Base>
